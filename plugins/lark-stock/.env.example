# 复制本文件为同目录 .env。启用插件只需填写下面的 App ID 与 App Secret。
# 云空间、多维表格、电子表格、消息接收方可后补，留空不影响启动。
# .env 已被 git 忽略，不要把真实凭证写回本文件。
# 已在进程环境里设置的同名变量优先于 .env。
#
# 应用凭证：飞书开放平台 → 应用 → 凭证与基础信息
# https://open.feishu.cn/app
LARK_APP_ID=
LARK_APP_SECRET=

# 开放平台域名：feishu（国内，默认）或 lark（国际）
# LARK_DOMAIN=feishu

# 云空间文件夹 token：打开目标文件夹，链接里 /folder/ 后面那一段
# 持久化文件会上传到这个文件夹。单文件不超过 20MB。
LARK_DRIVE_FOLDER_TOKEN=

# 多维表格：链接 /base/ 后面是 app_token；table= 后面是数据表 ID
LARK_BITABLE_APP_TOKEN=
LARK_BITABLE_TABLE_ID=

# 短线盘面写入用的多维表格（与上面的通用表分开）
DUANXIAN_BITABLE_APP_TOKEN=
DUANXIAN_BITABLE_TABLE_ID=

# 短线盘面上半部分（标签页以上）各卡片对应的列名。
# 留空时代码使用等号后面的页面中文名。盘中「上证/A股预测量能」与定稿后的量能是同一列。
DUANXIAN_DATE_BITABLE_KEY_NAME=日期
DUANXIAN_TEMPERATURE_BITABLE_KEY_NAME=情绪温度
DUANXIAN_BREADTH_BITABLE_KEY_NAME=大盘宽度
DUANXIAN_SPECULATION_BITABLE_KEY_NAME=题材投机
DUANXIAN_UP_BITABLE_KEY_NAME=上涨数
DUANXIAN_DOWN_BITABLE_KEY_NAME=下跌数
DUANXIAN_FLAT_BITABLE_KEY_NAME=平盘
DUANXIAN_ACTIVE_BITABLE_KEY_NAME=活跃度
DUANXIAN_SH_VOLUME_BITABLE_KEY_NAME=上证量能
DUANXIAN_A_VOLUME_BITABLE_KEY_NAME=A股量能
DUANXIAN_MAIN_INFLOW_BITABLE_KEY_NAME=主力净流入
DUANXIAN_VOL_RATIO_5D_BITABLE_KEY_NAME=5日量比
DUANXIAN_VOL_RATIO_20D_BITABLE_KEY_NAME=20日量比
DUANXIAN_EMOTION_SCORE_BITABLE_KEY_NAME=情绪分
DUANXIAN_PHASE_BITABLE_KEY_NAME=阶段
DUANXIAN_LIMIT_UP_BITABLE_KEY_NAME=涨停数
DUANXIAN_LIMIT_DOWN_BITABLE_KEY_NAME=跌停数
DUANXIAN_LEADER_BITABLE_KEY_NAME=龙头
DUANXIAN_THEMES_BITABLE_KEY_NAME=主线题材
DUANXIAN_OPEN_SUCCESS_BITABLE_KEY_NAME=打板成功率
DUANXIAN_ZT_PREMIUM_BITABLE_KEY_NAME=涨停溢价
DUANXIAN_LIANBAN_PREMIUM_BITABLE_KEY_NAME=连板溢价
DUANXIAN_PROMOTION_BITABLE_KEY_NAME=晋级率
DUANXIAN_BROKEN_RATE_BITABLE_KEY_NAME=炸板率
DUANXIAN_MAX_BOARDS_BITABLE_KEY_NAME=连板高度
DUANXIAN_LIANBAN_COUNT_BITABLE_KEY_NAME=连板数
DUANXIAN_ZT_DEEP_LOSS_BITABLE_KEY_NAME=昨涨停跌超5%
DUANXIAN_BROKEN_COUNT_BITABLE_KEY_NAME=炸板家数
DUANXIAN_RESONANCE_BITABLE_KEY_NAME=打板情绪共振

# 电子表格：链接 /sheets/ 后面是 spreadsheet token；sheet= 后面是工作表 ID
LARK_SPREADSHEET_TOKEN=
LARK_SHEET_ID=

# 发消息目标。receive_id_type：chat_id（群）/ open_id / user_id / union_id / email
LARK_IM_RECEIVE_ID_TYPE=chat_id
LARK_IM_RECEIVE_ID=
