# 复制本文件为同目录 .env，填完后再启用插件。
# .env 已被 git 忽略，不要把真实凭证写回本文件。
# 已在进程环境里设置的同名变量优先于 .env。
#
# 应用凭证：飞书开放平台 → 应用 → 凭证与基础信息
# https://open.feishu.cn/app
LARK_APP_ID=
LARK_APP_SECRET=

# 开放平台域名：feishu（国内，默认）或 lark（国际）
# LARK_DOMAIN=feishu

# 云空间文件夹 token：打开目标文件夹，链接里 /folder/ 后面那一段
# 持久化文件会上传到这个文件夹。单文件不超过 20MB。
LARK_DRIVE_FOLDER_TOKEN=

# 多维表格：链接 /base/ 后面是 app_token；table= 后面是数据表 ID
LARK_BITABLE_APP_TOKEN=
LARK_BITABLE_TABLE_ID=

# 电子表格：链接 /sheets/ 后面是 spreadsheet token；sheet= 后面是工作表 ID
LARK_SPREADSHEET_TOKEN=
LARK_SHEET_ID=

# 发消息目标。receive_id_type：chat_id（群）/ open_id / user_id / union_id / email
LARK_IM_RECEIVE_ID_TYPE=chat_id
LARK_IM_RECEIVE_ID=
